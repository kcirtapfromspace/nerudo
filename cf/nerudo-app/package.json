{
  "name": "nerudo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "brand:build": "python3 scripts/build-strand-assets.py && python3 scripts/build-social-preview.py && python3 scripts/package-brand-kit.py",
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
