    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "19.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vinext": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
